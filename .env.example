# Copy to .env.local, or generate it automatically with: npm run provision
#
# Both values are safe to expose in the browser bundle: the anon key is designed for public
# clients and every table is guarded by Row Level Security policies (see
# supabase/migrations/0001_init.sql). Never put the service_role key in a NEXT_PUBLIC_ variable.
#
# Leave these unset to run the app entirely on localStorage with no backend — the app detects
# the missing config and falls back automatically.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
